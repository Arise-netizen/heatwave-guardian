# ==============================================================================
# HeatWave Guardian — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local overrides:
#   cp .env.example .env    (Linux / macOS)
#   copy .env.example .env  (Windows PowerShell / Command Prompt)
#
# CRITICAL SECURITY RULE:
#   Never commit your actual .env file or real credentials to version control.
# ==============================================================================

# Flask Environment Mode ('production' or 'development')
FLASK_ENV=development

# Debug Mode (0 = disabled for production, 1 = enabled for local development)
FLASK_DEBUG=0

# Server Binding
HOST=0.0.0.0
PORT=5000

# Flask Application Secret Key (generate a strong random secret key in production)
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string

# Session Cookie Security (set to 1 when served strictly over HTTPS)
SESSION_COOKIE_SECURE=0

# Optional Telecom Alert Provider (Twilio)
# When omitted or empty, HeatWave Guardian operates in safe Simulation Mode,
# logging alerts to the in-memory audit trail without sending external SMS/WhatsApp.
# TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

# External Meteorological Service (Open-Meteo)
# Open-Meteo is public and requires no API key for non-commercial research/evaluation.
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
